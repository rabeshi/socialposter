# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=
CRON_SECRET=


# --- Database (Neon) ---
DATABASE_URL=
DIRECT_URL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM="Social Poster <onboarding@resend.dev>"
APPROVAL_EMAILS=
SEND_REAL_EMAILS=false

# --- LinkedIn (Phase 4) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback
LINKEDIN_ORGANIZATION_ID=

# --- X (Phase 4) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/integrations/x/callback

# --- Token encryption (Phase 4 OAuth token storage) ---
TOKEN_ENCRYPTION_KEY=

# --- Scheduling defaults ---
DEFAULT_TIMEZONE=America/Los_Angeles
GENERATION_INTERVAL_DAYS=2
DEFAULT_GENERATION_HOUR=9
DEFAULT_GENERATION_MINUTE=0

# --- Simulation mode ---
# When true (default), AI generation, images, email sending, and LinkedIn/X
# publishing are all mocked so the full workflow runs without any paid APIs
# or platform credentials. Set to false only once real credentials above are
# configured and you intend to generate/publish live content.
SIMULATION_MODE=true
